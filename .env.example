# Optional: link to sibling campus (duplicate deployment). Shown in header, mobile menu, footer.
# NEXT_PUBLIC_SISTER_SCHOOL_URL=https://your-other-campus.vercel.app
# NEXT_PUBLIC_SISTER_SCHOOL_LABEL=Our other campus

# Contact & online application — Web3Forms (https://web3forms.com)
#
# 1. Go to https://web3forms.com and create an access key with:
#    asamathsinstituteoflearning@gmail.com
# 2. Copy the access key from your email
# 3. Add to Vercel → Project → Settings → Environment Variables → Production (and Preview)
#
# Recommended (Contact form uses this from the browser):
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key-here
#
# Optional server-only key (also works for /api/application and /api/contact):
# WEB3FORMS_ACCESS_KEY=your-access-key-here
#
# Optional: attach application PDF to email (requires Web3Forms Pro — leave unset on Free):
# WEB3FORMS_ALLOW_ATTACHMENTS=true
