# Optional: link to sibling campus (duplicate deployment). Shown in header, mobile menu, footer.
# NEXT_PUBLIC_SISTER_SCHOOL_URL=https://your-other-campus.vercel.app
# NEXT_PUBLIC_SISTER_SCHOOL_LABEL=Our other campus

# Contact form (production) — "Send an Inquiry" posts to /api/contact and delivers to the school inbox.
# Inbox defaults to asamathsinstituteoflearning@gmail.com (see SCHOOL_INFO.email in src/lib/constants.ts).
#
# 1. Create a free account at https://resend.com
# 2. Add RESEND_API_KEY from the Resend dashboard
# 3. Set CONTACT_FORM_FROM_EMAIL to a verified sender (Resend → Domains, or use onboarding@resend.dev for testing)
# 4. On Vercel: Project → Settings → Environment Variables → add both for Production (and Preview if needed)
#
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_FORM_FROM_EMAIL=onboarding@resend.dev
# Optional override for the destination inbox:
# CONTACT_FORM_TO_EMAIL=asamathsinstituteoflearning@gmail.com
